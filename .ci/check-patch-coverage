#!/usr/bin/env bash

# @description Fail when code a change adds or modifies is never run by the
#              tests. Reads the profile `go test -coverprofile` already wrote,
#              finds every Go code block a line changed since --base falls
#              inside, and reports each one no test ran and no marker exempts.
#
#              .ci/check-coverage holds each package to its recorded figure,
#              which a small untested addition to a large, well-covered
#              package can slip under. This check is the per-change half: a
#              changed block is covered, or it says why not, in the code.
#
#              The escape is a `// coverage-exempt: <reason>` line comment
#              anywhere inside the block's line span, usually trailing the
#              `if ... {` line that opens it. It is judged in every tracked
#              .go file, not only changed ones, so markers cannot rot: one
#              with no reason, one outside every block (including any in a
#              _test.go file, which the profile never covers), and one whose
#              blocks are all run (stale: the tests caught up, so remove it)
#              each fail.
#
#              Markers are recognised one line at a time. A `//` after a `/*`
#              on the same line is seen as comment text, but a `/* ... */`
#              block comment spanning several lines is not tracked, so a
#              marker on one of its inner lines still counts. Do not leave
#              markers in commented-out code.
#
#              "Changed" is `git diff <base>` against the WORKING TREE, so
#              uncommitted edits count, matching the profile, which measured
#              the working tree. Untracked files are invisible to both git
#              diff and git grep; run-all-checks' warn_untracked says to add
#              them. A package whose tests failed to build is missing from the
#              profile, so its markers read as "not inside any code block":
#              noise next to the build failure, not a second bug.
#
#              The base is run-all-checks' `git merge-base HEAD origin/main`.
#              A branch dispatched from anything but main, or a PR onto
#              another base, is judged from its fork point from main, which
#              covers more than the change; this repository has neither.
#
#              Output names files, line spans and statement counts, never
#              source text.
# @option --base <rev> the commit to diff the working tree against
# @option --profile <file> the coverage profile go test wrote
# @exitcode 0 every changed block is run or exempt, and every marker is valid
# @exitcode 1 a finding: a changed block never run, a marker with no reason,
#             outside every block or stale, or a profile naming a file that
#             does not exist
# @exitcode 2 a setup failure, never a finding: bad arguments; not in a git
#             repository; --base not a commit; the profile missing, without a
#             mode: line, holding a line go would not write, or with no block
#             in the module; go.mod missing or without a module line; git
#             diff or git grep failing; a file name the diff header or git
#             grep output cannot carry; or awk itself failing

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# work is global, not local to main: the EXIT trap fires after main returns,
# when a local would already be out of scope and unbound under set -u.
work=''
trap 'rm -rf -- "${work}"' EXIT

function usage() {
  printf 'usage: %s --base REV --profile FILE\n' "${0##*/}" >&2
  exit 2
}

# @description Print a setup failure and exit 2. The ERR trap is dropped
#              first so the message is the last thing a reader sees, as
#              check-coverage does for its own verdicts.
# @arg $1 message
function fail_setup() {
  trap - ERR
  printf 'FAIL: %s\n' "$1" >&2
  exit 2
}

# @description Print `B<TAB>file<TAB>start<TAB>end<TAB>statements<TAB>run`
#              once per distinct block in the profile, file relative to the
#              repository root. A block listed more than once (a -coverpkg
#              profile compiles a file into several test binaries) is run if
#              any copy ran. Every mode (set, count, atomic) reads the same
#              way: a count above zero means run.
#
#              go itself writes profile lines space-delimited with no
#              escaping, so a file name containing a space (legal in a file
#              name, and go writes it unescaped either way) cannot be told
#              apart from the field separator by naive $1/$2/$3 splitting,
#              the way this used to work. The trailing
#              "<line>.<col>,<line>.<col> <statements> <count>" shape is
#              fixed and is anchored to the end of the line, so matching it
#              there finds the file:span boundary correctly regardless of
#              spaces earlier in the line.
#
#              Any other non-empty line fails the run. Skipping it would fail
#              open: a CRLF profile, or one with a mangled count, would read
#              as having no blocks, and every change would pass. Only the
#              line number is printed, never the line.
#
#              So does a profile with blocks none of which belong to the
#              module: it was written for another repository, and reading it
#              as "nothing here is profiled" would pass every change. A
#              profile of only the mode line is valid; go writes that for a
#              module with no statements.
# @arg $1 profile
# @arg $2 module path
function read_blocks() {
  local rc=0
  awk -v module="$2" '
    FNR == 1 || $0 == "" { next }
    {
      if (!match($0, /:[0-9]+\.[0-9]+,[0-9]+\.[0-9]+ [0-9]+ [0-9]+$/)) {
        # END still runs after exit; it reports the line and keeps the exit.
        bad = FNR
        exit 3
      }
      file = substr($0, 1, RSTART - 1)
      rest = substr($0, RSTART + 1, RLENGTH - 1)
      split(rest, fields, " ")
      span = fields[1]
      numstmt = fields[2] + 0
      count = fields[3] + 0
      blocks++
      prefix = module "/"
      if (substr(file, 1, length(prefix)) != prefix) next
      file = substr(file, length(prefix) + 1)
      split(span, ends, ",")
      split(ends[1], from, ".")
      split(ends[2], to, ".")
      key = file SUBSEP span
      if (!(key in stmts)) {
        order[++n] = key
        name[key] = file
        first[key] = from[1] + 0
        last[key] = to[1] + 0
        stmts[key] = numstmt
        ran[key] = 0
      }
      if (count > 0) ran[key] = 1
    }
    END {
      if (bad) {
        print bad
        exit 3
      }
      if (blocks > 0 && n == 0) exit 4
      for (i = 1; i <= n; i++) {
        k = order[i]
        printf "B\t%s\t%d\t%d\t%d\t%d\n", name[k], first[k], last[k], stmts[k], ran[k]
      }
    }
  ' "$1" > "${work}/blocks" || rc=$?
  if ((rc == 3)); then
    fail_setup "$1 line $(< "${work}/blocks") is not a Go coverage profile line"
  elif ((rc == 4)); then
    fail_setup "no block in $1 belongs to module $2; was it written for this repository?"
  elif ((rc != 0)); then
    fail_setup "awk failed reading $1 (exit ${rc})"
  fi
  cat "${work}/blocks"
}

# @description Print `C<TAB>file<TAB>line` for every line the working tree
#              adds or changes relative to base, in non-test .go files. Every
#              diff option that user or system git config can change is
#              pinned: diff.mnemonicPrefix and diff.noprefix rewrite the
#              `+++ b/` this parses, diff.interHunkContext merges hunks and
#              marks unchanged lines as changed, diff.external and
#              diff.relative replace or narrow the output, and a textconv
#              driver (diff.<driver>.textconv, picked by a diff= attribute)
#              rewrites the text itself, even to nothing. core.quotePath is
#              pinned off too, so an otherwise-plain UTF-8 file name (git's
#              default quotes anything outside ASCII) comes through
#              unquoted; a name git still quotes even so — a literal `"`, a
#              tab, or another control character, which quoting cannot spell
#              unambiguously in the `+++ b/<name>` line — is caught below and
#              fails the run rather than silently dropping the file's hunks.
#              Hunk bodies are skipped by count, not by pattern, so an added
#              line that itself begins with `++` is never mistaken for a file
#              header. The one exception is `\ No newline at end of file`,
#              which sits inside a hunk but is not in its counts: it is
#              skipped by pattern first, or it would use up the count and
#              leave the hunk's last line to be read as a header.
# @arg $1 base
function read_changed() {
  local rc=0
  git -c core.quotePath=false diff --unified=0 --inter-hunk-context=0 \
    --no-renames --no-color --no-ext-diff --no-textconv --no-relative --src-prefix=a/ --dst-prefix=b/ \
    "$1" -- '*.go' ':(exclude)*_test.go' > "${work}/diff" || rc=$?
  # Captured, not left to errexit: that would exit with git's own status,
  # which a caller cannot tell from a finding, behind the ERR trap's noise.
  if ((rc != 0)); then
    fail_setup "git diff against $1 failed"
  fi
  # awk's own exit status (not a sentinel in its output) carries the
  # unparsable-header case, so a bad header can never reach the facts file:
  # its "C" lines only get cat'd out below once awk has exited 0.
  awk '
    /^\\/ { next }
    skip > 0 { skip--; next }
    /^\+\+\+ / {
      file = ""
      if (substr($0, 1, 6) == "+++ b/") {
        file = substr($0, 7)
        # A name containing whitespace (e.g. a space) gets one trailing tab
        # appended, for GNU patch to find where the name ends; strip exactly
        # that one. A name with an embedded tab, which git cannot spell in
        # this header at all, would still carry a tab after the strip: that
        # is unparsable, same as a still-quoted name below, rather than
        # silently mismatching every profile line for the file.
        sub(/\t$/, "", file)
        if (file == "" || index(file, "\t") > 0) exit 3
      } else if ($0 != "+++ /dev/null") {
        # Still quoted despite core.quotePath=false: a name with a literal
        # quote, tab, backslash or other control character. Parsing it here
        # would risk mistaking quoting syntax for the name itself, so fail
        # closed instead of silently dropping that file, which would let an
        # unrun change pass.
        exit 3
      }
      next
    }
    /^@@ / {
      # @@ -a[,b] +c[,d] @@: b old lines and d new lines follow.
      n = split(substr($2, 2), old, ",")
      oldcount = (n > 1) ? old[2] + 0 : 1
      n = split(substr($3, 2), new, ",")
      start = new[1] + 0
      newcount = (n > 1) ? new[2] + 0 : 1
      skip = oldcount + newcount
      if (file == "") next
      for (i = 0; i < newcount; i++) printf "C\t%s\t%d\n", file, start + i
    }
  ' "${work}/diff" > "${work}/changed" || rc=$?
  if ((rc == 3)); then
    fail_setup 'cannot parse the diff header for a changed file; rename it or report this'
  elif ((rc != 0)); then
    fail_setup "awk failed reading the diff (exit ${rc})"
  fi
  cat "${work}/changed"
}

# @description Print `M<TAB>file<TAB>line<TAB>ok|noreason` for every
#              `// coverage-exempt:` line comment in a tracked .go file. The
#              matched text is never passed on. A `/* */` comment, even one
#              with `//` inside it, or the word in a string without `//`
#              before it, is not a marker.
#
#              git grep's default `name:line:text` cannot say where a name
#              containing a colon ends, and it quotes a name containing `"`
#              even with core.quotePath off. With -z it prints
#              `name<NUL>line<NUL>text`, the name verbatim; awk cannot
#              portably split on NUL, so tr turns each into \001 first. The
#              text may hold anything, tabs and colons included, so only the
#              first two separators are split on. A record without both (a
#              name with a newline in it), a name with a tab, which would
#              shift the facts' tab-separated fields, or a line number that
#              is not all digits (a name with a \001 in it) fails the run
#              rather than misattribute the marker.
function read_markers() {
  local rc=0
  git -c core.quotePath=false grep -z --full-name --line-number --no-color -I -E 'coverage-exempt:' -- '*.go' \
    > "${work}/grep" || rc=$?
  # 1 is "no match", which is the usual answer. Anything above it is the
  # scan failing, and must not read as "no markers", nor as a finding.
  if ((rc > 1)); then
    fail_setup "git grep failed (exit ${rc})"
  fi
  tr '\0' '\001' < "${work}/grep" > "${work}/grep-split"
  rc=0
  awk '
    {
      c1 = index($0, "\001")
      rest = substr($0, c1 + 1)
      c2 = index(rest, "\001")
      if (c1 < 2 || c2 < 2) exit 3
      file = substr($0, 1, c1 - 1)
      if (index(file, "\t") > 0) exit 3
      line = substr(rest, 1, c2 - 1)
      # A name holding a \001 of its own splits early, leaving part of the
      # name where the line number belongs.
      if (line !~ /^[0-9]+$/) exit 3
      text = substr(rest, c2 + 1)
      if (!match(text, /\/\/[[:space:]]*coverage-exempt:/)) next
      # A // inside an open /* ... */ is comment text, not a line comment.
      open = index(text, "/*")
      if (open > 0 && open < RSTART) {
        shut = index(substr(text, open), "*/")
        if (shut == 0 || open + shut - 1 > RSTART) next
      }
      reason = substr(text, RSTART + RLENGTH)
      printf "M\t%s\t%d\t%s\n", file, line, (reason ~ /[^[:space:]]/) ? "ok" : "noreason"
    }
  ' "${work}/grep-split" > "${work}/markers" || rc=$?
  if ((rc == 3)); then
    fail_setup 'cannot parse the git grep output for a file name; rename it or report this'
  elif ((rc != 0)); then
    fail_setup "awk failed reading the git grep output (exit ${rc})"
  fi
  cat "${work}/markers"
}

# @description Judge the blocks, changed lines and markers on stdin, and
#              print `file<TAB>line<TAB>message` per finding.
# @arg $1 the profile's file name, for messages
function judge() {
  # Through the environment, not -v: awk -v reads escape sequences, so a
  # backslash in the name would be mangled.
  PROFILE_NAME="$1" awk -F '\t' '
    $1 == "B" {
      n++; bf[n] = $2; bs[n] = $3 + 0; be[n] = $4 + 0; bn[n] = $5 + 0; br[n] = $6 + 0
      profiled[$2] = 1
      next
    }
    $1 == "C" { changed[$2, $3 + 0] = 1; touched[$2] = 1; next }
    $1 == "M" { m++; mf[m] = $2; ml[m] = $3 + 0; mok[m] = $4; next }
    END {
      profile = ENVIRON["PROFILE_NAME"]
      for (f in profiled) {
        if ((getline probe < f) < 0) {
          printf "%s\t0\tFAIL: %s names %s, which does not exist; rerun the tests\n", f, profile, f
        } else {
          close(f)
        }
      }
      for (i = 1; i <= m; i++) {
        inside = 0; unrun = 0
        for (j = 1; j <= n; j++) {
          if (bf[j] != mf[i] || ml[i] < bs[j] || ml[i] > be[j]) continue
          inside = 1
          if (!br[j]) unrun = 1
          if (mok[i] == "ok") exempt[j] = 1
        }
        if (mok[i] != "ok") {
          printf "%s\t%d\tFAIL: %s:%d coverage-exempt marker gives no reason\n", mf[i], ml[i], mf[i], ml[i]
        } else if (!inside) {
          printf "%s\t%d\tFAIL: %s:%d coverage-exempt marker is not inside any code block\n", mf[i], ml[i], mf[i], ml[i]
        } else if (!unrun) {
          printf "%s\t%d\tFAIL: %s:%d coverage-exempt marker is stale: the code it marks is covered; remove it\n", mf[i], ml[i], mf[i], ml[i]
        }
      }
      for (j = 1; j <= n; j++) {
        if (br[j] || exempt[j] || !(bf[j] in touched)) continue
        for (l = bs[j]; l <= be[j]; l++) {
          if ((bf[j], l) in changed) {
            printf "%s\t%d\tFAIL: %s:%d-%d (%d %s) is changed but never run; cover it, or mark it // coverage-exempt: <reason>\n", bf[j], bs[j], bf[j], bs[j], be[j], bn[j], (bn[j] == 1) ? "statement" : "statements"
            break
          }
        }
      }
    }
  '
}

function main() {
  local base='' profile=''
  while (($# > 0)); do
    case "$1" in
      --base)
        (($# >= 2)) || usage
        base="$2"
        shift 2
        ;;
      --profile)
        (($# >= 2)) || usage
        profile="$2"
        shift 2
        ;;
      *) usage ;;
    esac
  done
  [[ -n "${base}" && -n "${profile}" ]] || usage

  # A relative profile is relative to where the script was invoked, which is
  # about to change.
  [[ "${profile}" == /* ]] || profile="${PWD}/${profile}"

  local repo_dir
  if ! repo_dir="$(git rev-parse --show-toplevel 2> /dev/null)"; then
    fail_setup 'not inside a git repository'
  fi
  # Pathspecs such as '*.go' are relative to the current directory: from a
  # subdirectory the diff and git grep would silently see only that subtree.
  cd "${repo_dir}"

  if ! git rev-parse --verify --quiet "${base}^{commit}" > /dev/null; then
    fail_setup "--base ${base} is not a commit"
  fi
  if [[ ! -f "${profile}" || ! -r "${profile}" ]]; then
    fail_setup "${profile} does not exist; run the tests with -coverprofile first"
  fi
  local first=''
  IFS= read -r first < "${profile}" || true
  if [[ "${first}" != mode:* ]]; then
    fail_setup "${profile} is not a Go coverage profile (no mode: line)"
  fi
  if [[ ! -f go.mod ]]; then
    fail_setup 'no go.mod at the repository root'
  fi
  # go.mod may quote the module path (`module "example.com/x"`) or end its
  # lines in CRLF; neither the quotes nor the \r are part of it. .ci/check-coverage-drop's module_at parses go.mod
  # with this same awk expression; keep the two identical.
  local module
  module="$(awk '{ sub(/\r$/, "") } $1 == "module" { m = $2; if (m ~ /^".*"$/) m = substr(m, 2, length(m) - 2); print m; exit }' go.mod)"
  if [[ -z "${module}" ]]; then
    fail_setup 'go.mod has no module line'
  fi

  work="$(mktemp --directory)"
  {
    read_blocks "${profile}" "${module}"
    read_changed "${base}"
    read_markers
  } > "${work}/facts"
  judge "${profile##*/}" < "${work}/facts" | sort -t $'\t' -k1,1 -k2,2n | cut -f 3- > "${work}/findings"

  trap - ERR
  if [[ -s "${work}/findings" ]]; then
    cat "${work}/findings" >&2
    # The hint explains a changed block that is already covered on main; a
    # stale marker or a stale profile has nothing to do with origin/main
    # being behind, so printing it there would point at the wrong cause.
    if grep --quiet --fixed-strings 'is changed but never run' "${work}/findings"; then
      printf '(if this is already on main, origin/main may be stale: git fetch origin main)\n' >&2
    fi
    return 1
  fi
  return 0
}

main "$@"
