#!/usr/bin/env bash

# @description Open a pull request for every fuzz crasher .ci/run-fuzz just
#              found, one pull request per input.
#
#              A crasher is the entire value of a fuzzing run, and a red X on a
#              scheduled workflow throws it away: the input lives only in the
#              runner's working tree. So it is committed to a branch and filed
#              as a pull request, where the gate then fails on the very input
#              the branch carries — a reproducible failing test, already in a
#              branch, ready to fix.
#
#              The branch is named after the input's hash, so re-finding the
#              same crasher next week reuses the branch and files nothing new.
#              One branch per input, never reset onto the base: an unfixed
#              crasher pull request must not be clobbered by the next run.
#
#              The commit goes through the GraphQL createCommitOnBranch
#              mutation for the same reason .ci/refresh-pull-request does: the
#              protect-main ruleset requires signed commits, and commits made
#              through the API are GitHub-signed, where a push from a runner
#              would not be.
#
#              Auto-merge is deliberately never enabled here. This pull request
#              is supposed to be red.
# @noargs
# @exitcode 0 every new crasher is filed, or there were none
# @exitcode 1 a crasher was found but could not be filed

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR

# shellcheck source=.ci/lib.sh
source "${REPO_DIR}/.ci/lib.sh"

# @description Commit one corpus file to its own branch and open the pull
#              request carrying it.
# @arg $1 repo     owner/name
# @arg $2 base_sha the commit the branch is created at
# @arg $3 base     the default branch name
# @arg $4 file     repo-relative path of the corpus file
# @exitcode 1 the branch could not be created, committed to, or filed
function file_crasher() {
  local -r repo="$1" base_sha="$2" base="$3" file="$4"

  # internal/render/testdata/fuzz/FuzzSplice/bc1de2d73b69ddf6
  #  -> package internal/render, target FuzzSplice, input bc1de2d73b69ddf6
  local -r input="${file##*/}"
  local -r dir="${file%/*}"
  local -r target="${dir##*/}"
  local -r pkg="${file%%/testdata/fuzz/*}"
  local -r branch="test/fuzz-crasher-${input}"
  local -r headline="test: add fuzz crasher ${input} for ${target}"

  if gh api "repos/${repo}/git/ref/heads/${branch}" > '/dev/null' 2>&1; then
    ci::log "${branch} already exists; ${target}/${input} is already filed"
    return 0
  fi

  ci::log "creating ${branch} at ${base_sha}"
  gh api --method POST "repos/${repo}/git/refs" \
    --field "ref=refs/heads/${branch}" --field "sha=${base_sha}" > '/dev/null'

  ci::log "committing ${file}"
  # shellcheck disable=SC2016 # every $name in the query is GraphQL, not shell
  gh api graphql \
    --field "repo=${repo}" \
    --field "branch=${branch}" \
    --field "oid=${base_sha}" \
    --field "message=${headline}" \
    --field "path=${file}" \
    --field "contents=$(base64 --wrap=0 < "${REPO_DIR}/${file}")" \
    --raw-field 'query=
      mutation(
        $repo: String!
        $branch: String!
        $oid: GitObjectID!
        $message: String!
        $path: String!
        $contents: Base64String!
      ) {
        createCommitOnBranch(input: {
          branch: { repositoryNameWithOwner: $repo, branchName: $branch }
          expectedHeadOid: $oid
          message: { headline: $message }
          fileChanges: { additions: [{ path: $path, contents: $contents }] }
        }) { commit { oid } }
      }' > '/dev/null'

  ci::log 'opening the pull request'
  gh pr create --repo "${repo}" --base "${base}" --head "${branch}" \
    --title "${headline}" \
    --body "$(
      printf '%s\n' \
        "\`.github/workflows/fuzz.yml\` found an input that fails \`${target}\`." \
        '' \
        'The file this branch adds is a seed corpus entry, so the gate on this' \
        'pull request runs it as an ordinary test and is expected to be red.' \
        'Fix the code, keep the file: it becomes the regression test.' \
        '' \
        'Reproduce:' \
        '' \
        '```sh' \
        "./.ci/in-devshell go test -run '${target}/${input}' ./${pkg}/" \
        '```'
    )"
}

# @description Find every corpus file fuzzing just wrote and file each one.
# @noargs
function main() {
  cd "${REPO_DIR}"

  local repo base base_sha
  repo="${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is not set}"

  # Untracked only: fuzzing adds corpus files and never rewrites one, so an
  # untracked file under testdata/fuzz is exactly a newly discovered input.
  local -a crashers=()
  mapfile -t crashers < <(
    git ls-files --others --exclude-standard -- 'testdata/fuzz/*' '*/testdata/fuzz/*'
  )
  if ((${#crashers[@]} == 0)); then
    ci::log 'no new crashers; nothing to file'
    return 0
  fi
  ci::log "found ${#crashers[@]} new crasher(s)"

  base="$(gh api "repos/${repo}" --jq '.default_branch')"
  base_sha="$(gh api "repos/${repo}/git/ref/heads/${base}" --jq '.object.sha')"
  ci::log "base ${base} at ${base_sha}"

  local rc=0 crasher
  for crasher in "${crashers[@]}"; do
    file_crasher "${repo}" "${base_sha}" "${base}" "${crasher}" || rc=1
  done

  trap - ERR
  return "${rc}"
}

main "$@"
