#!/usr/bin/env bash

# @description Fuzz every `Fuzz` target in the tree for a bounded time.
#
#              `go test ./...` runs a fuzz target against its seed corpus and
#              nothing else: without `-fuzz`, no input is ever generated. This
#              script is the only thing in the repo that actually fuzzes, and
#              it is deliberately not part of the gate; see
#              .github/workflows/fuzz.yml for why.
#
#              One target per invocation, because `go test -fuzz` accepts
#              exactly one target and exactly one package at a time. Targets
#              are discovered rather than listed here, so a new `Fuzz` function
#              is fuzzed the moment it is written.
#
#              No `-race`: it costs roughly an order of magnitude in executions
#              per second, and the gate already runs every seed corpus under
#              the race detector.
#
#              Exit codes aggregate rather than fail fast, so one run finds
#              every crasher rather than the first. A crasher writes its input
#              to <pkg>/testdata/fuzz/<Target>/<hash>; that file is the entire
#              value of the run, and .ci/fuzz-pull-request is what carries it
#              out of a scheduled workflow.
#
#              Not every failure is a crasher. `go test -fuzz` sometimes fails
#              a target at the very end of -fuzztime with `context deadline
#              exceeded` and no input written, while the target was running
#              at full speed: its own shutdown, not a defect in the code under
#              test. So each target ends as one of:
#                PASS   it survived its budget, possibly on a retry
#                CRASH  it failed and a new input appeared under testdata/fuzz
#                FAIL   it failed with no input: a deadline-only failure that
#                       repeated on its one retry, or anything else (a build
#                       error), which is fuzzing infrastructure, not a finding
#              A deadline-only failure is retried once because a single one is
#              noise; failing the run on it would open an issue nobody can act
#              on. Twice in a row is worth a look.
# @arg $1 duration the Go duration to spend on each target, e.g. 30s or 5m
# @exitcode 0 every target passed
# @exitcode 1 a target crashed or failed, or a package could not be listed
# @exitcode 2 no duration was given

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

if [[ -z "${IN_DEVSHELL:-}" ]]; then
  SELF_PATH="$(readlink --canonicalize -- "${BASH_SOURCE[0]}")"
  SELF_DIR="${SELF_PATH%/*}"
  exec "${SELF_DIR}/in-devshell" "${SELF_PATH}" "$@"
fi

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR

# shellcheck source=.ci/lib.sh
source "${REPO_DIR}/.ci/lib.sh"

# What `go test` prints under a target that failed at its deadline.
readonly DEADLINE_LINE='context deadline exceeded'

# @description Print the untracked fuzz inputs, sorted, one per line. An
#              untracked file under testdata/fuzz is exactly an input written
#              by this run (the same test .ci/fuzz-pull-request uses).
# @noargs
# @stdout one repo-relative path per line
function untracked_inputs() {
  ci::ls_files --others --exclude-standard -- 'testdata/fuzz/*' '*/testdata/fuzz/*' \
    | tr '\0' '\n' | LC_ALL=C sort
}

# @description Fuzz one target once and say how it ended.
# @arg $1 pkg      the package's import path
# @arg $2 target   the fuzz function's name
# @arg $3 duration the Go duration to spend on it
# @arg $4 log      a file to keep its output in; the output is also streamed,
#                  to stderr, since stdout is the answer
# @stdout one of: pass, crash, deadline, error
function fuzz_once() {
  local -r pkg="$1" target="$2" duration="$3" log="$4"
  local before after status=0
  before="$(untracked_inputs)"
  go test "${pkg}" -run '^$' -fuzz "^${target}\$" -fuzztime "${duration}" 2>&1 | tee "${log}" >&2 || status=$?
  if ((status == 0)); then
    printf 'pass\n'
    return
  fi
  after="$(untracked_inputs)"
  # comm -13: lines only in the second list, i.e. inputs that just appeared.
  if [[ -n "$(LC_ALL=C comm -13 <(printf '%s\n' "${before}") <(printf '%s\n' "${after}"))" ]]; then
    printf 'crash\n'
  elif grep --quiet --fixed-strings -- "${DEADLINE_LINE}" "${log}"; then
    printf 'deadline\n'
  else
    printf 'error\n'
  fi
}

# @description Discover every fuzz target, fuzz each for the given duration,
#              and print a per-target summary.
# @arg $1 duration the Go duration to spend on each target
function main() {
  if (($# != 1)); then
    printf 'usage: %s <duration>\n' "${0##*/}" >&2
    exit 2
  fi
  local -r duration="$1"

  cd "${REPO_DIR}"

  # work is not local: see the EXIT-trap note in .ci/check-account-data main().
  work="$(mktemp --directory)"
  trap 'rm -rf -- "${work}"' EXIT

  local rc=0 crashed=0 failed=0
  local -a packages=() targets=() results=()
  mapfile -t packages < <(go list ./...)
  if ((${#packages[@]} == 0)); then
    ci::log 'no packages found - this is a failure, not a clean pass'
    exit 1
  fi

  local pkg listing line target outcome
  for pkg in "${packages[@]}"; do
    # `go test -list` prints the matching names and then the usual
    # `ok <pkg> <time>` line, so the names are filtered out by prefix. Captured
    # rather than piped: a package whose test binary does not build must fail
    # here, and a `| grep ... || true` pipeline would swallow that.
    if ! listing="$(go test -list '^Fuzz' "${pkg}")"; then
      ci::log "could not list the fuzz targets in ${pkg}"
      rc=1
      continue
    fi
    targets=()
    while IFS= read -r line; do
      if [[ "${line}" == Fuzz* ]]; then
        targets+=("${line}")
      fi
    done <<< "${listing}"

    for target in "${targets[@]}"; do
      ci::log "fuzzing ${target} in ${pkg} for ${duration}"
      outcome="$(fuzz_once "${pkg}" "${target}" "${duration}" "${work}/go-test.log")"
      if [[ "${outcome}" == deadline ]]; then
        ci::log "${target} failed at its deadline without writing an input; retrying it once"
        # A workflow command, so the retry shows on the run's summary page.
        printf '::warning title=fuzz deadline-only failure::%s in %s failed at its deadline without writing an input; retried once\n' \
          "${target}" "${pkg}" >&2
        outcome="$(fuzz_once "${pkg}" "${target}" "${duration}" "${work}/go-test.log")"
        if [[ "${outcome}" == pass ]]; then
          outcome='pass-retried'
        fi
      fi
      case "${outcome}" in
        pass) results+=("PASS ${pkg} ${target}") ;;
        pass-retried) results+=("PASS ${pkg} ${target} (retried after a deadline-only failure)") ;;
        crash)
          results+=("CRASH ${pkg} ${target}")
          crashed=1
          rc=1
          ;;
        *)
          results+=("FAIL ${pkg} ${target}")
          failed=1
          rc=1
          ;;
      esac
    done
  done

  if ((${#results[@]} == 0)); then
    ci::log 'no fuzz targets found - this is a failure, not a clean pass'
    exit 1
  fi

  ci::log "fuzzed ${#results[@]} target(s) for ${duration} each:"
  local result
  for result in "${results[@]}"; do
    ci::log "  ${result}"
  done
  if ((crashed != 0)); then
    ci::log 'a CRASH target wrote its input under <pkg>/testdata/fuzz/<Target>/'
  fi
  if ((failed != 0)); then
    ci::log 'a FAIL target wrote no input: that is a fuzzing-infrastructure failure, not a crasher'
  fi

  trap - ERR
  return "${rc}"
}

main "$@"
