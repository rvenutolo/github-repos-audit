#!/usr/bin/env bash

# @description Exercise .ci/gremlins-pull-request against a stub gh, so the
#              pull request it merges is proved to be the one it opened,
#              chosen by number and never by branch name, without any call
#              reaching GitHub. The stub answers the few reads the script
#              makes, prints a pull request URL for `pr create` as the real
#              command does, and records every argument list it was handed.
# @noargs
# @exitcode 0 every case passed
# @exitcode 1 a case failed

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR

# shellcheck source=.ci/lib.sh
source "${REPO_DIR}/.ci/lib.sh"

# @description Write a gh stand-in that logs each call and answers the reads.
# @arg $1 dir directory to put the stub in
# @arg $2 log file each call is appended to
function write_stub() {
  local -r dir="$1" log="$2"
  cat > "${dir}/gh" << STUB
#!/usr/bin/env bash
printf '%s\n' "\$*" >> '${log}'
case "\$*" in
  'api repos/gh-owner/report --jq .default_branch') echo main ;;
  'api repos/gh-owner/report/git/ref/heads/main --jq .object.sha') echo aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa0001 ;;
  'api repos/gh-owner/report/git/ref/heads/build/gremlins-0.6.0') exit 1 ;;
  pr\ create*) echo 'https://github.com/gh-owner/report/pull/42' ;;
  *) : ;;
esac
STUB
  chmod +x "${dir}/gh"
}

function main() {
  local rc=0
  # work is not local: see the EXIT-trap note in .ci/check-account-data main().
  work="$(mktemp --directory)"
  trap 'rm -rf -- "${work}"' EXIT

  # A throwaway repository holding a one-line package file with a bump in the
  # working tree, which is what the script reads. The script is run from here
  # so its repository root is this directory; lib.sh is copied in for the
  # source line.
  local -r repo="${work}/repo" log="${work}/calls.log"
  mkdir --parents "${repo}/nix" "${repo}/.ci" "${work}/bin"
  cp -- "${REPO_DIR}/.ci/lib.sh" "${repo}/.ci/lib.sh"
  printf '  version = "0.5.0";\n' > "${repo}/nix/gremlins.nix"
  git -C "${repo}" init --quiet --initial-branch=main
  git -C "${repo}" config user.name 'Test Author'
  git -C "${repo}" config user.email 'test@example.invalid'
  git -C "${repo}" config commit.gpgsign false
  git -C "${repo}" add nix/gremlins.nix
  git -C "${repo}" commit --quiet --message 'chore: start'
  printf '  version = "0.6.0";\n' > "${repo}/nix/gremlins.nix"
  write_stub "${work}/bin" "${log}"

  (cd "${repo}" && PATH="${work}/bin:${PATH}" GITHUB_REPOSITORY='gh-owner/report' \
    "${REPO_DIR}/.ci/gremlins-pull-request" > /dev/null 2>&1) || {
    ci::log 'FAIL: gremlins-pull-request exited non-zero'
    rc=1
  }

  if ! grep --quiet --fixed-strings -- 'pr create --repo gh-owner/report --base main --head build/gremlins-0.6.0 ' "${log}"; then
    ci::log 'FAIL: no pull request was opened for the bump'
    rc=1
  fi
  # The number create printed, not the branch name: gh resolves a branch
  # argument by head branch name alone, which a fork's pull request can share.
  if ! grep --quiet --fixed-strings -- 'pr merge 42 --repo gh-owner/report --merge --auto' "${log}"; then
    ci::log 'FAIL: auto-merge was not enabled on the number create printed'
    rc=1
  fi
  if grep --quiet --fixed-strings -- 'pr merge build/gremlins-0.6.0' "${log}"; then
    ci::log 'FAIL: auto-merge selected the pull request by branch name'
    rc=1
  fi

  ((rc == 0)) && ci::log 'gremlins-pull-request: every case passed'
  # A failing case is this harness's verdict, not a crash: drop the ERR trap
  # so a non-zero return does not add its own "ERROR: line ..." after the
  # case's FAIL line.
  trap - ERR
  return "${rc}"
}

main "$@"
