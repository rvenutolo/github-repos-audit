#!/usr/bin/env bash

# @description Run a command inside this repo's Nix devShell with a hermetic
#              environment. The single entrypoint for every gate: the pre-push
#              hook, the .justfile recipes, and every CI step go through it, so
#              local and CI runs cannot drift and no gate can silently resolve a
#              tool from the ambient machine.
#
#              `nix develop --ignore-environment` is what makes the boundary
#              real: without it the devShell inherits the caller's PATH and an
#              undeclared dependency keeps resolving from /usr/bin. Because the
#              environment is wiped, the few variables the gates genuinely need
#              are re-admitted through the fixed KEEP_VARS allowlist below.
#
#              When IN_DEVSHELL is already set the command is run directly, with
#              no second nix evaluation: the caller is inside the boundary.
#
#              `nix develop` makes temp directories of its own and execs the
#              command, so nothing it leaves would ever be removed. The script
#              therefore runs it as a child inside a private directory made
#              under the caller's TMPDIR, with TMPDIR kept and pointing there,
#              and deletes that directory once the command has ended, however
#              it ends. Everything nix and the command write to TMPDIR goes
#              with it.
#
#              "The command" is the direct child, nix and what it execs. The
#              directory is removed only after that child exits, and not on a
#              signal alone: a command that catches one keeps running in it.
#              Processes the command leaves running in the background are not
#              waited for. SIGTERM and SIGHUP are forwarded to the command
#              only, so a command that dies without passing one on can leave
#              descendants running after the directory is gone; `timeout` and
#              CI cancellation signal the whole process group, which reaches
#              them. A SIGINT sent to this script alone, not to the foreground
#              process group, is not forwarded at all: a Ctrl-C already reaches
#              the command through the process group, and forwarding would
#              deliver it twice.
#
#              Standalone on purpose: it runs before the environment it creates,
#              so it cannot source a function library. It needs only bash, git,
#              GNU mktemp, readlink and rm, and nix from the host. Every script
#              that re-runs itself through this wrapper has the same
#              requirement before the devShell exists.
# @arg $@ command the command to run inside the devShell, plus its arguments
# @stderr the usage line, or the reason the script cannot run
# @exitcode 0 the wrapped command succeeded
# @exitcode 1 no command given, not inside a git repo, TMPDIR names no
#             directory, or the host bash is too old
# @exitcode 129 hung up before the command started (130 interrupted, 143
#               terminated)
# @exitcode * otherwise the wrapped command's exit status (128+N when a signal
#             killed it), nix's own when the devShell cannot be entered, or the
#             failing mktemp or readlink status

set -Eeuo pipefail
# This script runs under the HOST bash, before the devShell it creates exists,
# so the host's version is whatever the machine ships. `shopt -s inherit_errexit`
# below is a bash 4.4 builtin option: on stock macOS bash 3.2 the shell aborts
# with `shopt: inherit_errexit: invalid shell option name`, which tells a
# coworker running `just check` nothing about what to install. Check first, and
# say what to do. Must stay ABOVE the `shopt` line it is protecting. The GNU
# long options of readlink, mktemp and rm used below are a host requirement
# too; on macOS that is GNU coreutils.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  printf '%s: bash 4.4+ and GNU coreutils required to run the gate (found bash %s.%s). On macOS: brew install bash coreutils, with the coreutils gnubin directory first on PATH.\n' \
    "${0##*/}" "${BASH_VERSINFO[0]}" "${BASH_VERSINFO[1]}" >&2
  exit 1
fi
# Without this, errexit is off inside every $(...) subshell, so a command
# substitution runs past a failed command and the caller never notices. Set
# here for parity with every gate script that runs through this wrapper.
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "\033[0;31m[%s] ERROR: line %s (exit %s): %s\033[0m\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# `--keep` on an unset variable is silent and harmless, so every name is passed
# unconditionally rather than set-checked. HOME is a deliberate residue: gh
# auth, the Go module and build caches and the nix config live there, so host
# dotfiles such as ~/.shellcheckrc can still shape a LOCAL run in ways a clean
# CI HOME will not. Neither Go cache is at Go's default (~/go and
# ~/.cache/go-build, which every Go on the machine shares): flake.nix's
# shellHook exports GOPATH as ~/.cache/go, GOMODCACHE as ~/.cache/go/mod and
# a GOCACHE under ~/.cache/github-repos-audit/go-build that is named after
# this devShell's toolchain. No GO* variable is kept, so one from the caller
# never replaces them.
#
# ACTIONS_ID_TOKEN_REQUEST_URL and ACTIONS_ID_TOKEN_REQUEST_TOKEN are how a
# job with `id-token: write` asks GitHub for its OIDC token. cosign's keyless
# signing in .ci/release-publish exchanges that token for a certificate naming
# the workflow; without the pair it finds no identity and falls back to a
# browser login nobody is there to complete. A job without that permission
# has neither variable set.
#
# GITHUB_WORKFLOW_REF names the workflow file and the ref a run belongs to.
# It is the identity in the certificate cosign is issued, so
# .ci/release-publish verifies the signature it just made against it; the
# script signs nothing without it.
readonly KEEP_VARS=(
  HOME
  TERM
  CI
  IN_DEVSHELL
  NIX_SSL_CERT_FILE
  # Points at the private directory made below, so what nix and the command
  # write there is removed with it.
  TMPDIR
  GITHUB_ACTIONS
  GITHUB_OUTPUT
  GITHUB_ENV
  GITHUB_STEP_SUMMARY
  GITHUB_WORKSPACE
  GITHUB_REPOSITORY
  GITHUB_REF
  GITHUB_REF_NAME
  GITHUB_SHA
  GITHUB_EVENT_NAME
  GITHUB_WORKFLOW_REF
  GITHUB_TOKEN
  GH_TOKEN
  GH_REPO
  SMOKE_OWNER
  SMOKE_PUBLIC_REPO
  SMOKE_PRIVATE_REPO
  RUNNER_OS
  RUNNER_TEMP
  ACTIONS_ID_TOKEN_REQUEST_URL
  ACTIONS_ID_TOKEN_REQUEST_TOKEN
)

# Global, not local to main: the EXIT trap runs after main has returned.
tmp_dir=''
child_pid=''
got_signal=''

# shellcheck disable=SC2329 # invoked by the EXIT trap in main
function remove_tmp_dir() {
  if [[ -n "${tmp_dir}" ]]; then
    rm --recursive --force -- "${tmp_dir:?}"
  fi
}

# A Ctrl-C reaches the child through the shared process group, so SIGINT is not
# forwarded: a second copy would read as a second Ctrl-C, which makes pytest
# abort its teardown. SIGTERM and SIGHUP are usually sent to this script alone,
# and reach the child only through this forward. The traps stay set, so every
# further signal is handled too, and main keeps waiting until the child has
# ended: the directory is never removed under a child still running, and the
# exit status is the child's own. A signal landing between the launch and the
# assignment of child_pid finds the child through `$!`; before the launch `$!`
# is unset and there is nothing to wait for, so the script exits at once with
# the conventional status. The status is also recorded in got_signal, for main's
# wait loop.
# shellcheck disable=SC2329 # invoked by the INT, TERM and HUP traps in main
function on_signal() {
  local -r signal_name="$1"
  local -r status="$2"
  child_pid="${child_pid:-${!:-}}"
  if [[ -z "${child_pid}" ]]; then
    exit "${status}"
  fi
  got_signal="${status}"
  if [[ "${signal_name}" != 'INT' ]]; then
    kill -s "${signal_name}" "${child_pid}" 2> '/dev/null' || true
  fi
}

function main() {
  if (($# == 0)); then
    printf 'usage: %s <command> [args...]\n' "${0##*/}" >&2
    exit 1
  fi

  # Already inside the boundary: run directly, skip a second nix evaluation.
  # Everything the shellHook exported, the keyed GOCACHE included, reaches
  # the command by inheritance; .ci/check-gocache-keyed fails the gate when
  # IN_DEVSHELL was set by something that never ran the hook.
  if [[ -n "${IN_DEVSHELL:-}" ]]; then
    exec "$@"
  fi

  local repo_dir
  if ! repo_dir="$(git rev-parse --show-toplevel 2> '/dev/null')"; then
    printf '%s: not a git repo: %s\n' "${0##*/}" "$(pwd)" >&2
    exit 1
  fi
  readonly repo_dir

  export IN_DEVSHELL=1

  # The flake reference is the repo this script was invoked in, never a relative
  # path: a gate must evaluate the tree it is grading.
  local -a nix_args=(develop "${repo_dir}" --ignore-environment)
  local keep_var
  for keep_var in "${KEEP_VARS[@]}"; do
    nix_args+=(--keep "${keep_var}")
  done
  nix_args+=(--command)

  local -r parent_dir="${TMPDIR:-/tmp}"
  if [[ ! -d "${parent_dir}" ]]; then
    printf '%s: TMPDIR %s does not exist\n' "${0##*/}" "${parent_dir}" >&2
    exit 1
  fi
  trap remove_tmp_dir EXIT
  trap 'on_signal HUP 129' HUP
  trap 'on_signal INT 130' INT
  trap 'on_signal TERM 143' TERM
  # Absolute, because nix rejects a relative TMPDIR and the command could not
  # use one after changing directory.
  tmp_dir="$(mktemp --directory --tmpdir="$(readlink --canonicalize -- "${parent_dir}")" in-devshell.XXXXXX)"
  export TMPDIR="${tmp_dir}"

  # Run in the background only so `wait` can be interrupted by the traps above;
  # a foreground child would hold them off until it exited. Without job control
  # bash starts a background child with SIGINT and SIGQUIT ignored and stdin on
  # /dev/null, so the subshell restores both signals and stdin is passed
  # explicitly: the command behaves as it would in the foreground.
  (
    trap - INT QUIT
    exec nix "${nix_args[@]}" "$@"
  ) <&0 &
  child_pid="$!"
  # A trapped signal cuts `wait` short, so wait again until one returns because
  # the child ended. When the child ends during a wait a trap cut short, bash
  # reaps it but loses its status (5.2 then reports 255, 5.3 reports 127), and
  # the pid stops answering `kill -0`; the child almost surely died of that
  # signal, so the conventional 128+N stands in for the status.
  local rc=0
  local signal_status=''
  while true; do
    got_signal=''
    if [[ -n "${signal_status}" ]] && ! kill -0 "${child_pid}" 2> '/dev/null'; then
      rc="${signal_status}"
      break
    fi
    rc=0
    wait "${child_pid}" || rc="$?"
    if [[ -z "${got_signal}" ]]; then
      break
    fi
    signal_status="${got_signal}"
  done
  exit "${rc}"
}

main "$@"
