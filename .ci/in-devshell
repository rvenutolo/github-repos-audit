#!/usr/bin/env bash

# @description Run a command inside this repo's Nix devShell with a hermetic
#              environment. The single entrypoint for every gate: the pre-push
#              hook, the .justfile recipes, and every CI step go through it, so
#              local and CI runs cannot drift and no gate can silently resolve a
#              tool from the ambient machine.
#
#              `nix develop --ignore-environment` is what makes the boundary
#              real: without it the devShell inherits the caller's PATH and an
#              undeclared dependency keeps resolving from /usr/bin. Because the
#              environment is wiped, the few variables the gates genuinely need
#              are re-admitted through the fixed KEEP_VARS allowlist below.
#
#              Standalone on purpose: it runs before the environment it creates,
#              so it cannot source a function library. It needs only bash, git
#              and nix from the host.
# @arg $@ command the command to run inside the devShell, plus its arguments
# @exitcode 0 the wrapped command succeeded
# @exitcode 1 no command given, not inside a git repo, or the host bash is too old
# @exitcode * otherwise the wrapped command's exit status

set -Eeuo pipefail
# This script runs under the HOST bash, before the devShell it creates exists,
# so the host's version is whatever the machine ships. `shopt -s inherit_errexit`
# below is a bash 4.4 builtin option: on stock macOS bash 3.2 the shell aborts
# with `shopt: inherit_errexit: invalid shell option name`, which tells a
# coworker running `just check` nothing about what to install. Check first, and
# say what to do. Must stay ABOVE the `shopt` line it is protecting.
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  printf '%s: bash 4.4+ required to run the gate (found %s.%s). On macOS: brew install bash.\n' \
    "${0##*/}" "${BASH_VERSINFO[0]}" "${BASH_VERSINFO[1]}" >&2
  exit 1
fi
# Without this, errexit is off inside every $(...) subshell, so a command
# substitution runs past a failed command and the caller never notices. Set
# here for parity with every gate script that runs through this wrapper.
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "\033[0;31m[%s] ERROR: line %s (exit %s): %s\033[0m\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# `--keep` on an unset variable is silent and harmless, so every name is passed
# unconditionally rather than set-checked. HOME is a deliberate residue: gh
# auth, the Go module cache (~/go), the Go build cache and the nix config live
# there, so host dotfiles such as ~/.shellcheckrc can still shape a LOCAL run
# in ways a clean CI HOME will not. The build cache is not Go's default
# ~/.cache/go-build, which every Go on the machine shares: flake.nix's
# shellHook exports a GOCACHE under ~/.cache/github-repos-audit/go-build that
# is named after this devShell's toolchain. No GO* variable is kept, so a
# GOCACHE from the caller never replaces it.
#
# ACTIONS_ID_TOKEN_REQUEST_URL and ACTIONS_ID_TOKEN_REQUEST_TOKEN are how a
# job with `id-token: write` asks GitHub for its OIDC token. cosign's keyless
# signing in .ci/release-publish exchanges that token for a certificate naming
# the workflow; without the pair it finds no identity and falls back to a
# browser login nobody is there to complete. A job without that permission
# has neither variable set.
#
# GITHUB_WORKFLOW_REF names the workflow file and the ref a run belongs to.
# It is the identity in the certificate cosign is issued, so
# .ci/release-publish verifies the signature it just made against it; the
# script signs nothing without it.
readonly KEEP_VARS=(
  HOME
  TERM
  CI
  IN_DEVSHELL
  NIX_SSL_CERT_FILE
  GITHUB_ACTIONS
  GITHUB_OUTPUT
  GITHUB_ENV
  GITHUB_STEP_SUMMARY
  GITHUB_WORKSPACE
  GITHUB_REPOSITORY
  GITHUB_REF
  GITHUB_REF_NAME
  GITHUB_SHA
  GITHUB_EVENT_NAME
  GITHUB_WORKFLOW_REF
  GITHUB_TOKEN
  GH_TOKEN
  GH_REPO
  SMOKE_OWNER
  SMOKE_PUBLIC_REPO
  SMOKE_PRIVATE_REPO
  RUNNER_OS
  RUNNER_TEMP
  ACTIONS_ID_TOKEN_REQUEST_URL
  ACTIONS_ID_TOKEN_REQUEST_TOKEN
)

function main() {
  if (($# == 0)); then
    printf 'usage: %s <command> [args...]\n' "${0##*/}" >&2
    exit 1
  fi

  # Already inside the boundary: run directly, skip a second nix evaluation.
  # Everything the shellHook exported, the keyed GOCACHE included, reaches
  # the command by inheritance; .ci/check-gocache-keyed fails the gate when
  # IN_DEVSHELL was set by something that never ran the hook.
  if [[ -n "${IN_DEVSHELL:-}" ]]; then
    exec "$@"
  fi

  local repo_dir
  if ! repo_dir="$(git rev-parse --show-toplevel 2> '/dev/null')"; then
    printf '%s: not a git repo: %s\n' "${0##*/}" "$(pwd)" >&2
    exit 1
  fi
  readonly repo_dir

  export IN_DEVSHELL=1

  # The flake reference is the repo this script was invoked in, never a relative
  # path: a gate must evaluate the tree it is grading.
  local -a nix_args=(develop "${repo_dir}" --ignore-environment)
  local keep_var
  for keep_var in "${KEEP_VARS[@]}"; do
    nix_args+=(--keep "${keep_var}")
  done
  nix_args+=(--command)

  exec nix "${nix_args[@]}" "$@"
}

main "$@"
