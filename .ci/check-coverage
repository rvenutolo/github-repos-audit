#!/usr/bin/env bash

# @description Hold per-package statement coverage to the recorded baseline.
#              Reads the profile `go test -coverprofile` already wrote, sums
#              covered and total statements per package straight from it, and
#              fails when a package has fallen below the figure in
#              .ci/coverage-baseline.txt by any amount at all.
#
#              The baseline is committed, so a deliberate drop is a reviewable
#              line in the diff rather than a silent one, and coverage
#              ratchets: `just cover-update` records whatever the code now
#              achieves, and it can never quietly slide back.
#
#              There is no tolerance because coverage is reproducible run to
#              run, and it has to stay that way. The gate used to allow a
#              1.0-point drop for a cancellation test in internal/github that
#              reached doRetrying's backoff exit only sometimes. Once #6 made
#              that test wait for the client to be in its backoff before
#              cancelling, 46 runs made after #8 (including GOMAXPROCS=1 and 2)
#              covered exactly the same blocks. A block that comes and goes between runs is a racy test,
#              and the fix is that test, never a tolerance: slack sized for one
#              flake hides every real drop smaller than it, and a gate that
#              fails on its own nondeterminism teaches people to rerun until
#              it passes. A toolchain bump that changes statement counts is a
#              deterministic change, recorded with `just cover-update` in the
#              same commit.
#
#              This is the per-package half. .ci/check-patch-coverage is the
#              per-change half: every Go block a change touches must be run,
#              or carry a `// coverage-exempt: <reason>` line comment inside
#              it.
#
#              .ci/check-coverage-drop makes a lowered line in the baseline
#              carry its reason, as a trailer on the commit that lowers it:
#              `Coverage-Drop: <package dir> - <reason>`, in the message's
#              last paragraph beside Co-Authored-By (a paragraph of its own
#              is not a trailer to git).
# @arg $1 mode  check (default), --print or --update
# @exitcode 0 every package is at or above its baseline
# @exitcode 1 a package regressed, or the baseline and the package list disagree

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR

# PROFILE is what run-all-checks' `go test` step writes.
readonly PROFILE="${REPO_DIR}/coverage.out"
readonly BASELINE="${REPO_DIR}/.ci/coverage-baseline.txt"

# NO_STATEMENTS marks a package the compiler produces no statements for, which
# is not the same as one that is untested: there is nothing there to cover.
readonly NO_STATEMENTS='n/a'

# @description Print `<package> <tenths>` for every package in the module,
#              where tenths is statement coverage in tenths of a point, or
#              NO_STATEMENTS for a package with nothing to cover. Packages come
#              from `go list` rather than from the profile so that one with no
#              statements is still listed, and adding the first function to it
#              is noticed rather than silently unmeasured.
# @noargs
# @stdout one `<package> <tenths|n/a>` line per package, sorted
function measure() {
  local -a packages=()
  mapfile -t packages < <(cd "${REPO_DIR}" && go list ./...)
  if ((${#packages[@]} == 0)); then
    printf 'FAIL: go list returned no packages - the scan looks broken\n' >&2
    return 1
  fi

  # The profile's first line is `mode:`; every other line is
  # `<import-path>/<file>.go:<range> <numStmts> <count>`. Coverage is summed
  # over statements, never averaged over per-function percentages, which would
  # weight a one-line function the same as a fifty-line one.
  printf '%s\n' "${packages[@]}" | awk -v profile="${PROFILE}" -v none="${NO_STATEMENTS}" '
    BEGIN {
      while ((getline line < profile) > 0) {
        if (line ~ /^mode:/) continue
        split(line, f, " ")
        colon = index(f[1], ":")
        if (colon == 0) continue
        file = substr(f[1], 1, colon - 1)
        slash = 0
        for (i = length(file); i > 0; i--) {
          if (substr(file, i, 1) == "/") { slash = i; break }
        }
        if (slash == 0) continue
        pkg = substr(file, 1, slash - 1)
        total[pkg] += f[2]
        if (f[3] > 0) covered[pkg] += f[2]
      }
      close(profile)
    }
    { if (total[$0] > 0) printf "%s %d\n", $0, int(1000 * covered[$0] / total[$0] + 0.5)
      else printf "%s %s\n", $0, none }
  ' | sort
}

# @description Render tenths as a percentage, or pass NO_STATEMENTS through.
# @arg $1 tenths the value to render
# @stdout the rendered figure
function render() {
  if [[ "$1" == "${NO_STATEMENTS}" ]]; then
    printf '%s' "${NO_STATEMENTS}"
  else
    printf '%d.%d%%' "$(($1 / 10))" "$(($1 % 10))"
  fi
}

# @description Print the current table, changing nothing.
# @noargs
function print_table() {
  local pkg value
  while IFS=' ' read -r pkg value; do
    printf '%-58s %8s\n' "${pkg}" "$(render "${value}")"
  done < <(measure)
}

# @description Rewrite the baseline from the current measurement.
# @noargs
function update_baseline() {
  local pkg value
  {
    printf '# Per-package statement coverage, held by .ci/check-coverage.\n'
    printf '#\n'
    printf '# Generated by: just cover-update. Never edit by hand. A line that\n'
    printf '# goes down in a diff is a deliberate loss of coverage and should be\n'
    printf '# justified in the commit message that carries it.\n'
    printf '#\n'
    printf '# n/a marks a package with no statements to cover.\n'
    while IFS=' ' read -r pkg value; do
      printf '%s %s\n' "${pkg}" "$(render "${value}")"
    done < <(measure)
  } > "${BASELINE}"
  ci_note "wrote ${BASELINE#"${REPO_DIR}/"}"
}

# @description Print one INFO line, matching the gate scripts' format. This
#              script is run directly by `just cover` as well as from
#              run-all-checks, so it does not source .ci/lib.sh for one helper.
# @arg $1 message the text to print
function ci_note() {
  printf '[%s] INFO %s\n' "${0##*/}" "$1" >&2
}

# @description Print the baseline as `<package> <tenths|n/a>`, so it is in the
#              same units as measure() and every comparison is integer.
# @noargs
# @stdout one `<package> <tenths|n/a>` line per recorded package
function read_baseline() {
  local pkg figure
  while IFS=' ' read -r pkg figure; do
    [[ -z "${pkg}" || "${pkg}" == '#'* ]] && continue
    if [[ "${figure}" == "${NO_STATEMENTS}" ]]; then
      printf '%s %s\n' "${pkg}" "${NO_STATEMENTS}"
    else
      # `98.4%` -> 984 tenths.
      figure="${figure%\%}"
      printf '%s %d\n' "${pkg}" "$((10#${figure%.*} * 10 + 10#${figure#*.}))"
    fi
  done < "${BASELINE}"
}

# @description Compare the current measurement against the baseline.
# @noargs
function check() {
  local rc=0
  local -A want=()
  local pkg figure
  while IFS=' ' read -r pkg figure; do
    want["${pkg}"]="${figure}"
  done < <(read_baseline)

  if ((${#want[@]} == 0)); then
    printf 'FAIL: %s records no packages - the baseline looks broken\n' "${BASELINE}" >&2
    return 1
  fi

  local value seen=0
  local -A present=()
  while IFS=' ' read -r pkg value; do
    present["${pkg}"]=1
    seen=$((seen + 1))
    if [[ -z "${want[${pkg}]:-}" ]]; then
      printf 'FAIL: %s is not in the baseline; run: just cover-update\n' "${pkg}" >&2
      rc=1
      continue
    fi
    local recorded="${want[${pkg}]}"
    if [[ "${recorded}" == "${NO_STATEMENTS}" && "${value}" != "${NO_STATEMENTS}" ]]; then
      printf 'FAIL: %s had no statements and now has some (%s); run: just cover-update\n' \
        "${pkg}" "$(render "${value}")" >&2
      rc=1
      continue
    fi
    if [[ "${value}" == "${NO_STATEMENTS}" && "${recorded}" != "${NO_STATEMENTS}" ]]; then
      printf 'FAIL: %s was %s and now has no statements at all\n' \
        "${pkg}" "$(render "${recorded}")" >&2
      rc=1
      continue
    fi
    [[ "${value}" == "${NO_STATEMENTS}" ]] && continue
    if ((value < recorded)); then
      printf 'FAIL: %s coverage %s is below the recorded %s\n' \
        "${pkg}" "$(render "${value}")" "$(render "${recorded}")" >&2
      rc=1
    fi
  done < <(measure)

  if ((seen == 0)); then
    printf 'FAIL: measured no packages - the scan looks broken\n' >&2
    rc=1
  fi

  # A baseline line naming a package that no longer exists is a line nobody
  # will ever notice is stale, which is the same reasoning CheckCoverage
  # applies to repos.toml.
  for pkg in "${!want[@]}"; do
    if [[ -z "${present[${pkg}]:-}" ]]; then
      printf 'FAIL: the baseline names %s, which is no longer a package; run: just cover-update\n' \
        "${pkg}" >&2
      rc=1
    fi
  done

  return "${rc}"
}

function main() {
  local mode="${1:-check}"

  # Every mode reads the profile, --update included: awk treats a missing file
  # as an empty one, so an unguarded update would record every package as
  # having no statements and call it a baseline.
  if [[ ! -f "${PROFILE}" ]]; then
    printf 'FAIL: %s does not exist; run the tests with -coverprofile first\n' "${PROFILE}" >&2
    trap - ERR
    return 1
  fi

  local rc=0
  case "${mode}" in
    check) check || rc=$? ;;
    --print) print_table ;;
    --update) update_baseline ;;
    *)
      printf 'FAIL: unknown mode %s; expected check, --print or --update\n' "${mode}" >&2
      rc=1
      ;;
  esac

  # A gate reporting its own verdict is not a crash: drop the ERR trap so the
  # diagnostics above are the last thing the reader sees (#43, invariant 6).
  trap - ERR
  return "${rc}"
}

main "$@"
