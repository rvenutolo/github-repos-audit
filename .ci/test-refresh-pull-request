#!/usr/bin/env bash

# @description Exercise .ci/refresh-pull-request against a stub gh, so the
#              files it commits are proved to come from --dir without any call
#              reaching GitHub. The stub answers the few reads the script
#              makes and records every argument list it was handed, and a
#              copy of the GraphQL request body it was given with --input.
# @noargs
# @exitcode 0 every case passed
# @exitcode 1 a case failed

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

REPO_DIR="$(git rev-parse --show-toplevel)"
readonly REPO_DIR

# shellcheck source=.ci/lib.sh
source "${REPO_DIR}/.ci/lib.sh"

# The default branch's head, as the stub reports it.
readonly BASE='aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa0001'

# The commit the stub's createCommitOnBranch answers with.
readonly COMMIT='c0ffeec0ffeec0ffeec0ffeec0ffeec0ffee0001'

# @description Write a gh stand-in that logs each call and answers the reads.
#              `pr list` answers from `pr-list.json` in the stub's directory
#              by running the script's own jq filter, the last argument, over
#              it, so which pull request the script adopts is the script's
#              doing and not the stub's. Neither the refresh branch nor its
#              staging branch exists. createCommitOnBranch copies its --input
#              body to `graphql-body.json`, since the script removes the
#              original on exit, records the original's path in
#              `graphql-input-path`, and answers with the contents of
#              `commit-oid` (COMMIT when absent). `pr create`
#              prints the contents of `create-output` (nothing when absent),
#              as the real command prints the new pull request's URL on
#              stdout.
# @arg $1 dir directory to put the stub in
# @arg $2 log file each call is appended to
function write_stub() {
  local -r dir="$1" log="$2"
  printf '[]\n' > "${dir}/pr-list.json"
  cat > "${dir}/gh" << STUB
#!/usr/bin/env bash
printf '%s\n' "\$*" >> '${log}'
case "\$*" in
  'api repos/gh-owner/report --jq .default_branch') echo main ;;
  'api repos/gh-owner/report/git/ref/heads/main --jq .object.sha') echo '${BASE}' ;;
  'api repos/gh-owner/report/git/ref/heads/chore/refresh-audit') exit 1 ;;
  'api repos/gh-owner/report/git/ref/heads/chore/refresh-audit-staging') exit 1 ;;
  api\ graphql*)
    prev=''
    for arg in "\$@"; do
      if [[ "\${prev}" == --input ]]; then
        cp -- "\${arg}" '${dir}/graphql-body.json'
        printf '%s\n' "\${arg}" > '${dir}/graphql-input-path'
      fi
      prev="\${arg}"
    done
    if [[ -f '${dir}/commit-oid' ]]; then cat '${dir}/commit-oid'; else echo '${COMMIT}'; fi
    ;;
  pr\ list*) jq --raw-output "\${!#}" '${dir}/pr-list.json' ;;
  pr\ create*) if [[ -f '${dir}/create-output' ]]; then cat '${dir}/create-output'; fi ;;
  *) : ;;
esac
STUB
  chmod +x "${dir}/gh"
}

# @description Run the script against a fresh stub whose open pull requests
#              named chore/refresh-audit are the given list, and leave its
#              calls in ${work}/<name>/calls.log.
# @arg $1 name  case directory under ${work}
# @arg $2 list  the pull requests, as `gh pr list --json` prints them
function run_case() {
  local -r name="$1" list="$2"
  mkdir --parents "${work}/${name}"
  write_stub "${work}/${name}" "${work}/${name}/calls.log"
  printf '%s\n' "${list}" > "${work}/${name}/pr-list.json"
  printf '%s\n' 'https://github.com/gh-owner/report/pull/42' > "${work}/${name}/create-output"
  PATH="${work}/${name}:${PATH}" GITHUB_REPOSITORY='gh-owner/report' \
    "${REPO_DIR}/.ci/refresh-pull-request" --dir "${work}/report" > /dev/null 2>&1 || {
    ci::log "FAIL: ${name}: refresh-pull-request exited non-zero"
    rc=1
  }
}

# @description Assert some logged call of a case begins with the given text.
# @arg $1 name case directory under ${work}
# @arg $2 text the prefix a call must start with
function want_call() {
  local line
  while IFS= read -r line; do
    [[ "${line}" == "$2"* ]] && return 0
  done < "${work}/$1/calls.log"
  ci::log "FAIL: $1: no call beginning '$2'"
  rc=1
}

# @description Assert no logged call of a case contains the given text.
# @arg $1 name case directory under ${work}
# @arg $2 text the text no call may contain
function want_no_call() {
  if grep --quiet --fixed-strings -- "$2" "${work}/$1/calls.log"; then
    ci::log "FAIL: $1: unexpected call '$2'"
    rc=1
  fi
}

# @description Assert no pull request subcommand (view, edit, close, merge,
#              ...) names the given pull request number.
# @arg $1 name   case directory under ${work}
# @arg $2 number the pull request that must stay untouched
function want_untouched() {
  if grep --quiet --extended-regexp -- "^pr [a-z-]+ $2( |\$)" "${work}/$1/calls.log"; then
    ci::log "FAIL: $1: a pr call named #$2"
    rc=1
  fi
}

# @description Assert the GraphQL body a case sent satisfies a jq filter. The
#              filter sees the files under --dir, base64-encoded, as
#              $readme and $audit, read from files so that a report too
#              large for one argument can still be compared.
# @arg $1 name   case directory under ${work}
# @arg $2 filter jq expression that must be true of the body
# @arg $3 what   what the filter checks, for the failure line
function want_body() {
  local -r body="${work}/$1/graphql-body.json"
  if [[ ! -f "${body}" ]] || ! jq --exit-status \
    --rawfile readme "${work}/expected-readme.b64" \
    --rawfile audit "${work}/expected-audit.b64" \
    "$2" "${body}" > '/dev/null'; then
    ci::log "FAIL: $1: the commit body does not carry $3"
    rc=1
  fi
}

# @description Record the base64 of the files under ${work}/report, for
#              want_body to compare against.
# @noargs
function encode_report() {
  base64 --wrap=0 < "${work}/report/README.md" > "${work}/expected-readme.b64"
  base64 --wrap=0 < "${work}/report/audit.json" > "${work}/expected-audit.b64"
}

# A pull request opened from a fork whose branch is named like ours is a
# stranger's: the script must never touch or merge it.
function test_fork_pull_requests_are_never_adopted() {
  local fork='{"number":7,"isCrossRepository":true}'
  local own='{"number":9,"isCrossRepository":false}'

  # An entry without the field is not known to be ours.
  local unknown='{"number":8}'

  run_case fork-only "[${fork},${unknown}]"
  want_call fork-only 'pr list --repo gh-owner/report --head chore/refresh-audit --state open --limit 1000 '
  want_untouched fork-only 8
  want_call fork-only 'pr create --repo gh-owner/report'
  want_call fork-only 'pr merge 42 --repo gh-owner/report --merge --auto'
  want_untouched fork-only 7
  want_no_call fork-only 'pr merge chore/refresh-audit'

  run_case fork-and-own "[${fork},${own}]"
  want_call fork-and-own 'pr merge 9 --repo gh-owner/report --merge --auto'
  want_untouched fork-and-own 7
  want_no_call fork-and-own 'pr create'

  # A pull request the script opens is merged by the number it printed, never
  # by branch name.
  run_case none '[]'
  want_call none 'pr merge 42 --repo gh-owner/report --merge --auto'
  want_no_call none 'pr merge chore/refresh-audit'
}

# The commit is made on the staging branch, set at the base, and the refresh
# branch is moved onto that commit, never onto the base: GitHub closes a pull
# request whose branch equals its base.
function test_refresh_branch_never_at_base() {
  run_case own '[{"number":9,"isCrossRepository":false}]'
  want_call own "api --method POST repos/gh-owner/report/git/refs --field ref=refs/heads/chore/refresh-audit-staging --field sha=${BASE}"
  want_call own 'api graphql --input '
  want_body own '.variables.repo == "gh-owner/report"' 'the repository'
  want_body own '.variables.branch == "chore/refresh-audit-staging"' 'the staging branch'
  want_body own ".variables.oid == \"${BASE}\"" 'the base as the expected head'
  # The body file lives in a temporary directory the script removes on exit.
  local input
  input="$(< "${work}/own/graphql-input-path")"
  if [[ -e "${input}" || -e "${input%/*}" ]]; then
    ci::log "FAIL: own: the request body's directory ${input%/*} outlived the run"
    rc=1
  fi
  want_call own "api --method POST repos/gh-owner/report/git/refs --field ref=refs/heads/chore/refresh-audit --field sha=${COMMIT}"
  want_no_call own "heads/chore/refresh-audit --field sha=${BASE}"
  want_call own 'api --method DELETE repos/gh-owner/report/git/refs/heads/chore/refresh-audit-staging'
  want_call own 'pr merge 9 --repo gh-owner/report --merge --auto'
}

# A commit the API does not name stops the run before the refresh branch is
# touched or anything is merged.
function test_commit_without_oid_stops_before_moving() {
  local -r name='commit-without-oid'
  mkdir --parents "${work}/${name}"
  write_stub "${work}/${name}" "${work}/${name}/calls.log"
  printf '[{"number":9,"isCrossRepository":false}]\n' > "${work}/${name}/pr-list.json"
  : > "${work}/${name}/commit-oid"
  if PATH="${work}/${name}:${PATH}" GITHUB_REPOSITORY='gh-owner/report' \
    "${REPO_DIR}/.ci/refresh-pull-request" --dir "${work}/report" > /dev/null 2>&1; then
    ci::log "FAIL: ${name}: exited zero"
    rc=1
  fi
  want_no_call "${name}" 'heads/chore/refresh-audit --field'
  want_no_call "${name}" 'pr merge'
}

# A report whose base64 is larger than one argument may be (128 KiB) still
# commits, with every byte of it, because the files travel in the request
# body rather than in argv.
function test_report_larger_than_one_argument_commits() {
  local -r name='large-report' saved="${work}/report/audit.json.small"
  mv -- "${work}/report/audit.json" "${saved}"
  local i
  {
    printf '['
    for ((i = 0; i < 12000; i++)); do printf '{"x":"PAYLOAD"},'; done
    printf '{"x":"PAYLOAD"}]\n'
  } > "${work}/report/audit.json"
  encode_report
  if (($(wc --bytes < "${work}/expected-audit.b64") <= 131072)); then
    ci::log "FAIL: ${name}: the filler is too small to exceed one argument"
    rc=1
  fi

  run_case "${name}" '[{"number":9,"isCrossRepository":false}]'
  # shellcheck disable=SC2016 # $readme and $audit are jq variables, not shell
  want_body "${name}" '.variables.audit == $audit' 'the full audit.json'
  # shellcheck disable=SC2016 # $readme and $audit are jq variables, not shell
  want_body "${name}" '.variables.readme == $readme' 'README.md'
  want_call "${name}" "api --method POST repos/gh-owner/report/git/refs --field ref=refs/heads/chore/refresh-audit --field sha=${COMMIT}"
  want_call "${name}" 'pr merge 9 --repo gh-owner/report --merge --auto'

  mv -- "${saved}" "${work}/report/audit.json"
  encode_report
}

# Output that does not end in a number must stop the run before any merge:
# an empty argument or a word would make gh pick the pull request itself.
function test_unusable_create_output_stops_before_merging() {
  local output name
  for output in '' 'https://github.com/gh-owner/report/pull/42/files'; do
    name="create-printed-${output:+files}${output:-nothing}"
    name="${name//[^a-z-]/}"
    mkdir --parents "${work}/${name}"
    write_stub "${work}/${name}" "${work}/${name}/calls.log"
    printf '%s' "${output}" > "${work}/${name}/create-output"
    if PATH="${work}/${name}:${PATH}" GITHUB_REPOSITORY='gh-owner/report' \
      "${REPO_DIR}/.ci/refresh-pull-request" --dir "${work}/report" > /dev/null 2>&1; then
      ci::log "FAIL: ${name}: exited zero"
      rc=1
    fi
    want_no_call "${name}" 'pr merge'
  done
}

function main() {
  # work is not local: see the EXIT-trap note in .ci/check-account-data main().
  local rc=0
  work="$(mktemp --directory)"
  trap 'rm -rf -- "${work}"' EXIT

  mkdir --parents "${work}/bin" "${work}/report"
  printf '# report from --dir\n' > "${work}/report/README.md"
  printf '{"owner":"gh-owner"}\n' > "${work}/report/audit.json"
  encode_report
  write_stub "${work}/bin" "${work}/bin/calls.log"
  printf '%s\n' 'https://github.com/gh-owner/report/pull/42' > "${work}/bin/create-output"

  PATH="${work}/bin:${PATH}" GITHUB_REPOSITORY='gh-owner/report' \
    "${REPO_DIR}/.ci/refresh-pull-request" --dir "${work}/report" > /dev/null 2>&1 || {
    ci::log 'FAIL: refresh-pull-request --dir exited non-zero'
    rc=1
  }

  # shellcheck disable=SC2016 # $readme and $audit are jq variables, not shell
  want_body bin '.variables.readme == $readme' 'README.md from --dir'
  # shellcheck disable=SC2016 # $readme and $audit are jq variables, not shell
  want_body bin '.variables.audit == $audit' 'audit.json from --dir'
  # The query is the createCommitOnBranch mutation over exactly these
  # variables, so the body and the query cannot drift apart.
  want_body bin '.query | test("createCommitOnBranch")' 'the createCommitOnBranch mutation'
  want_body bin '.variables | keys == ["audit", "branch", "oid", "readme", "repo"]' 'exactly the mutation variables'
  # No file contents in argv: that is the limit the body file exists to avoid.
  want_no_call bin 'readme='
  want_no_call bin 'audit='

  if PATH="${work}/bin:${PATH}" GITHUB_REPOSITORY='gh-owner/report' \
    "${REPO_DIR}/.ci/refresh-pull-request" --dir "${work}/missing" > /dev/null 2>&1; then
    ci::log 'FAIL: a --dir without README.md and audit.json was accepted'
    rc=1
  fi

  local usage_got=0
  PATH="${work}/bin:${PATH}" GITHUB_REPOSITORY='gh-owner/report' \
    "${REPO_DIR}/.ci/refresh-pull-request" --bogus > /dev/null 2>&1 || usage_got=$?
  if [[ "${usage_got}" != 2 ]]; then
    ci::log "FAIL: an unknown argument: exit ${usage_got}, want 2"
    rc=1
  fi

  # --dir with no value is a usage error (exit 2); see the --dir case in
  # .ci/refresh-pull-request for why not exit 1.
  local dir_got=0
  PATH="${work}/bin:${PATH}" GITHUB_REPOSITORY='gh-owner/report' \
    "${REPO_DIR}/.ci/refresh-pull-request" --dir > /dev/null 2>&1 || dir_got=$?
  if [[ "${dir_got}" != 2 ]]; then
    ci::log "FAIL: --dir with no value: exit ${dir_got}, want 2"
    rc=1
  fi

  test_fork_pull_requests_are_never_adopted
  test_refresh_branch_never_at_base
  test_commit_without_oid_stops_before_moving
  test_unusable_create_output_stops_before_merging
  test_report_larger_than_one_argument_commits

  ((rc == 0)) && ci::log 'refresh-pull-request: every case passed'
  # A failing case is this harness's verdict, not a crash: drop the ERR trap
  # so a non-zero return does not add its own "ERROR: line ..." after the
  # case's FAIL line, as check-coverage does for its designed returns.
  trap - ERR
  return "${rc}"
}

main "$@"
