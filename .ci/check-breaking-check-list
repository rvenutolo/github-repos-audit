#!/usr/bin/env bash

# @description Fail when the set of checks a repository type must list in
#              audit.schema.json changes without a breaking-change marker on
#              some commit in the range. A consumer's repos.toml must list
#              every check for every repository type, so adding or removing a
#              check turns every consumer's valid configuration into an
#              invalid one: under semantic versioning that is a major
#              release, and the release version is computed from commit
#              types, so a new check committed as a plain `feat:` would
#              publish a minor version. This catches the forgotten `!`.
#
#              The set is the `required` list of the `type` definition in
#              audit.schema.json, read at the range's base and at its head;
#              order is irrelevant. A revision without the file has an empty
#              set. A schema that does not parse, or lacks the list, is a
#              finding rather than a pass: an unreadable list cannot be
#              shown unchanged.
#
#              Either marker, on any commit in the range (a merge commit
#              included), clears the finding: a subject of the form
#              `type!:` or `type(scope)!:`, or a message line starting with
#              `BREAKING CHANGE:` or `BREAKING-CHANGE:`.
# @option --range <base>..<head> the commits to judge; an empty head means HEAD
# @exitcode 0 the check list is unchanged, or the range carries a marker
# @exitcode 1 a finding: the list changed with no marker, or a schema
#             could not be read
# @exitcode 2 a setup failure, never a finding: bad arguments; not in a git
#             repository; the range not resolving; or git failing

set -Eeuo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

trap 'printf "[%s] ERROR: line %s (exit %s): %s\n" "${0##*/}" "${LINENO}" "$?" "${BASH_COMMAND}" >&2' ERR

# From beside this script, not from the repository root: its tests run it
# inside throwaway repositories, which carry no .ci/lib.sh of their own.
# shellcheck source=.ci/lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

readonly SCHEMA='audit.schema.json'

# Conventional Commits breaking subject: type, optional scope, then `!:`.
readonly BREAKING_SUBJECT='^[a-z]+(\([^)]*\))?!:'
readonly BREAKING_FOOTER='^BREAKING[ -]CHANGE:'

function usage() {
  printf 'usage: %s --range BASE..HEAD\n' "${0##*/}" >&2
  exit 2
}

# @description Print a setup failure and exit 2. The ERR trap is dropped
#              first so the message is the last thing a reader sees.
# @arg $1 message
function fail_setup() {
  trap - ERR
  printf 'FAIL: %s\n' "$1" >&2
  exit 2
}

# @description Print the check names of the schema at a commit, sorted, one
#              per line; nothing if the commit has no schema. Returns 1,
#              with a message, when the schema does not parse or lacks the
#              list. `input` makes an empty file an error instead of an
#              empty set, and the type test makes a missing list one too.
#              Run in a command substitution, so fail_setup ends only that
#              subshell: the caller sees the status and exits 2 itself.
# @arg $1 commit
# @arg $2 how to name the commit in a message
function checks_at() {
  local listed schema
  # quoted-name-ok: only whether the listing is empty is read, never the name.
  listed="$(git ls-tree --name-only "$1" -- "${SCHEMA}")" || fail_setup "git ls-tree failed for $2:${SCHEMA}"
  [[ -n "${listed}" ]] || return 0
  schema="$(git show --no-color "$1:${SCHEMA}")" || fail_setup "git show failed for $2:${SCHEMA}"
  local names
  if ! names="$(jq --null-input --raw-output \
    'input | ."$defs".type.required | if type == "array" then .[] else error("no check list") end' \
    <<< "${schema}" 2> /dev/null)"; then
    printf 'FAIL: %s at %s is not parsable or lacks the check list (%s)\n' "${SCHEMA}" "$2" "\$defs.type.required" >&2
    return 1
  fi
  [[ -z "${names}" ]] || LC_ALL=C sort <<< "${names}"
}

function main() {
  local range=''
  while (($# > 0)); do
    case "$1" in
      --range)
        (($# >= 2)) || usage
        range="$2"
        shift 2
        ;;
      *) usage ;;
    esac
  done
  [[ "${range}" == *..* ]] || usage

  local repo_dir
  if ! repo_dir="$(git rev-parse --show-toplevel 2> /dev/null)"; then
    fail_setup 'not inside a git repository'
  fi
  cd "${repo_dir}"

  local base_rev="${range%%..*}" head_rev="${range#*..}" base head
  : "${head_rev:=HEAD}"
  if ! base="$(git rev-parse --verify --quiet "${base_rev}^{commit}")" \
    || ! head="$(git rev-parse --verify --quiet "${head_rev}^{commit}")"; then
    fail_setup "--range ${range} does not resolve"
  fi

  local before after rc=0
  before="$(checks_at "${base}" 'the range base')" || rc=$?
  ((rc != 2)) || exit 2
  if ((rc == 0)); then
    after="$(checks_at "${head}" 'the range head')" || rc=$?
  fi
  if ((rc != 0)); then
    trap - ERR
    return 1
  fi

  local added removed
  added="$(comm -13 <(printf '%s\n' "${before}") <(printf '%s\n' "${after}") | sed '/^$/d')"
  removed="$(comm -23 <(printf '%s\n' "${before}") <(printf '%s\n' "${after}") | sed '/^$/d')"
  if [[ -z "${added}${removed}" ]]; then
    return 0
  fi

  # Subjects and the rest of each message are read apart so the subject
  # pattern never matches a body line. git failing must not read as "no
  # marker found", so each log goes to a variable under a guard.
  local subjects bodies
  subjects="$(git log --no-show-signature --no-color --format='%s' "${base}..${head}")" \
    || fail_setup "git log failed for --range ${range}"
  bodies="$(git log --no-show-signature --no-color --format='%b' "${base}..${head}")" \
    || fail_setup "git log failed for --range ${range}"
  if grep --quiet --extended-regexp -- "${BREAKING_SUBJECT}" <<< "${subjects}" \
    || grep --quiet --extended-regexp -- "${BREAKING_FOOTER}" <<< "${bodies}"; then
    return 0
  fi

  trap - ERR
  printf 'FAIL: the check list in %s changed in %s with no breaking marker.\n' "${SCHEMA}" "${range}" >&2
  [[ -z "${added}" ]] || printf '  checks added: %s\n' "$(tr '\n' ' ' <<< "${added}")" >&2
  [[ -z "${removed}" ]] || printf '  checks removed: %s\n' "$(tr '\n' ' ' <<< "${removed}")" >&2
  printf 'Every consumer'\''s repos.toml must list every check, so this is a breaking change:\n' >&2
  printf 'mark a commit with %s (or any type!:) or a %s footer.\n' 'feat!:' 'BREAKING CHANGE:' >&2
  return 1
}

main "$@"
